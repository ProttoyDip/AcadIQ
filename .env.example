# ---- MySQL (Docker) ----
MYSQL_DATABASE=acadiq
MYSQL_USER=acadiq_user
MYSQL_PASSWORD=acadiq_pass
MYSQL_ROOT_PASSWORD=root_pass

# ---- Backend ----
PORT=5000
# For local (non-Docker) backend dev: MySQL is published on host port 3308.
DATABASE_URL=mysql://acadiq_user:acadiq_pass@localhost:3308/acadiq
JWT_SECRET=local_only_change_this_32_char_secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# AI provider key (OpenAI-compatible / Groq / Python FastAPI). Never commit real keys.
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1/chat/completions # For Groq: https://api.groq.com/openai/v1/chat/completions | OpenAI: https://api.openai.com/v1/chat/completions
OPENAI_MODEL=llama-3.3-70b-versatile # For Groq: llama-3.3-70b-versatile | OpenAI: gpt-4o-mini
AI_TIMEOUT_MS=45000
MAX_AI_INPUT_CHARS=80000

# Optional additional OpenAI-compatible chat providers, in fallback order.
# See docs/ai-providers.md. Keys stay in server environment variables, never in JSON or VITE_*.
AI_PROVIDERS_JSON=[]
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_BACKUP_API_KEY=

# ---- Python AI Microservice ----
HF_TOKEN=
MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# ---- Local Ollama AI Runtime ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=gemma3:4b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=120000

# ---- Frontend ----
VITE_API_URL=http://localhost:5000/api

