# ---- MySQL (Docker) ----
MYSQL_DATABASE=acadiq
MYSQL_USER=acadiq_user
MYSQL_PASSWORD=acadiq_pass
MYSQL_ROOT_PASSWORD=root_pass

# ---- Backend ----
PORT=5000
DATABASE_URL=mysql://acadiq_user:acadiq_pass@localhost:3306/acadiq
JWT_SECRET=local_only_change_this_32_char_secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# AI provider key (OpenAI-compatible). Never commit real keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=45000
MAX_AI_INPUT_CHARS=80000

# ---- Frontend ----
VITE_API_URL=http://localhost:5000/api
