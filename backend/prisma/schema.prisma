generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FACULTY
}

enum ReportType {
  EXAM_QUALITY
  SYLLABUS_COVERAGE
  QUESTION_SIMILARITY
  QUESTION_REVIEW
  CO_MAPPING
  ACADEMIC_MEMORY
  GENERATED_PAPER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ChatRole {
  USER
  ASSISTANT
}

model User {
  id                  Int                  @id @default(autoincrement())
  name                String               @db.VarChar(100)
  email               String               @unique @db.VarChar(191)
  password            String               @db.VarChar(255)
  role                Role                 @default(FACULTY)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  facultyProfile      FacultyProfile?
  courses             Course[]
  reports             AnalysisReport[]
  rubrics             Rubric[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  copilotThreads      CopilotThread[]
  chatSessions        ChatSession[]
  questionFeedback    QuestionFeedback[]
  aiDocuments         Document[]
  generatedQuestions  GeneratedQuestion[]

  @@map("users")
}

model FacultyProfile {
  id          Int    @id @default(autoincrement())
  userId      Int    @unique @map("user_id")
  department  String @db.VarChar(120)
  designation String @db.VarChar(120)
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("faculty_profiles")
}

model Course {
  id                Int                @id @default(autoincrement())
  facultyId         Int                @map("faculty_id")
  courseCode        String             @map("course_code") @db.VarChar(30)
  courseName        String             @map("course_name") @db.VarChar(180)
  description       String?            @db.Text
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  faculty           User               @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  syllabusDocuments SyllabusDocument[]
  teachingMaterials TeachingMaterial[]
  questionPapers    QuestionPaper[]
  reports           AnalysisReport[]
  rubrics           Rubric[]
  questionHistory   QuestionHistory[]
  courseOutcomes    CourseOutcome[]
  copilotThreads    CopilotThread[]
  chatSessions      ChatSession[]

  @@unique([facultyId, courseCode])
  @@index([facultyId])
  @@map("courses")
}

model SyllabusDocument {
  id            Int      @id @default(autoincrement())
  courseId      Int      @map("course_id")
  originalName  String   @map("original_name") @db.VarChar(255)
  filePath      String   @map("file_path") @db.VarChar(500)
  mimeType      String   @map("mime_type") @db.VarChar(100)
  fileSize      Int      @map("file_size")
  /// Text extracted at upload so analyses and copilot turns never re-parse the PDF.
  extractedText String?  @map("extracted_text") @db.LongText
  uploadedAt    DateTime @default(now()) @map("uploaded_at")
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chunks        SyllabusChunk[]

  @@index([courseId, uploadedAt])
  @@map("syllabus_documents")
}

/// Retrieval unit for the Copilot: ~500-char passages of a syllabus, embedded as SYLLABUS_CHUNK.
model SyllabusChunk {
  id                 Int              @id @default(autoincrement())
  syllabusDocumentId Int              @map("syllabus_document_id")
  chunkIndex         Int              @map("chunk_index")
  content            String           @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  syllabusDocument   SyllabusDocument @relation(fields: [syllabusDocumentId], references: [id], onDelete: Cascade)

  @@unique([syllabusDocumentId, chunkIndex])
  @@map("syllabus_chunks")
}

/// Slides, lecture notes, handouts — what was actually taught. Chunked and embedded as TEACHING_CHUNK
/// so the Copilot and the paper generator ground themselves in the delivered content, not just the syllabus.
model TeachingMaterial {
  id            Int                     @id @default(autoincrement())
  courseId      Int                     @map("course_id")
  title         String                  @db.VarChar(200)
  originalName  String                  @map("original_name") @db.VarChar(255)
  filePath      String                  @map("file_path") @db.VarChar(500)
  mimeType      String                  @map("mime_type") @db.VarChar(100)
  fileSize      Int                     @map("file_size")
  kind          String                  @db.VarChar(20) // SLIDES | NOTES | HANDOUT | OTHER
  extractedText String?                 @map("extracted_text") @db.LongText
  chunkCount    Int                     @default(0) @map("chunk_count")
  uploadedAt    DateTime                @default(now()) @map("uploaded_at")
  course        Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chunks        TeachingMaterialChunk[]

  @@index([courseId, uploadedAt])
  @@map("teaching_materials")
}

model TeachingMaterialChunk {
  id         Int              @id @default(autoincrement())
  materialId Int              @map("material_id")
  chunkIndex Int              @map("chunk_index")
  /// Slide number or page hint parsed from the text, when available.
  locator    String?          @db.VarChar(40)
  content    String           @db.Text
  createdAt  DateTime         @default(now()) @map("created_at")
  material   TeachingMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, chunkIndex])
  @@map("teaching_material_chunks")
}

model QuestionPaper {
  id           Int              @id @default(autoincrement())
  courseId     Int              @map("course_id")
  year         Int
  semester     String           @db.VarChar(50)
  originalName String           @map("original_name") @db.VarChar(255)
  filePath     String           @map("file_path") @db.VarChar(500)
  mimeType     String           @map("mime_type") @db.VarChar(100)
  fileSize     Int              @map("file_size")
  uploadedAt   DateTime         @default(now()) @map("uploaded_at")
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions    Question[]
  reports      AnalysisReport[]
  chatSessions ChatSession[]

  @@index([courseId, uploadedAt])
  @@map("question_papers")
}

model Question {
  id             Int                 @id @default(autoincrement())
  paperId        Int                 @map("paper_id")
  sequenceNumber Int                 @map("sequence_number")
  questionText   String              @map("question_text") @db.Text
  marks          Int                 @default(0)
  topic          String?             @db.VarChar(191)
  bloomLevel     String?             @map("bloom_level") @db.VarChar(30)
  paper          QuestionPaper       @relation(fields: [paperId], references: [id], onDelete: Cascade)
  studentAnswers StudentAnswer[]
  coMappings     QuestionCOMapping[]
  historyEntry   QuestionHistory?
  feedback       QuestionFeedback[]

  @@unique([paperId, sequenceNumber])
  @@index([paperId])
  @@map("questions")
}

model AnalysisReport {
  id               Int                 @id @default(autoincrement())
  facultyId        Int                 @map("faculty_id")
  courseId         Int?                @map("course_id")
  questionPaperId  Int?                @map("question_paper_id")
  reportType       ReportType          @map("report_type")
  resultJson       Json                @map("result_json")
  createdAt        DateTime            @default(now()) @map("created_at")
  faculty          User                @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  course           Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  questionPaper    QuestionPaper?      @relation(fields: [questionPaperId], references: [id], onDelete: SetNull)
  recommendations  Recommendation[]
  examQualityScore ExamQualityScore?
  explanation      AIExplanation?
  coMappings       QuestionCOMapping[]
  analysisRuns     AnalysisRun[]
  questionFeedback QuestionFeedback[]

  @@index([facultyId, createdAt])
  @@index([courseId])
  @@index([questionPaperId])
  @@map("analysis_reports")
}

model Recommendation {
  id        Int            @id @default(autoincrement())
  reportId  Int            @map("report_id")
  message   String         @db.Text
  priority  Priority       @default(MEDIUM)
  createdAt DateTime       @default(now()) @map("created_at")
  report    AnalysisReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("recommendations")
}

model ExamQualityScore {
  id                 Int            @id @default(autoincrement())
  reportId           Int            @unique @map("report_id")
  qualityScore       Decimal        @map("quality_score") @db.Decimal(5, 2)
  scoreFactors       Json           @map("score_factors")
  positivePoints     Json           @map("positive_points")
  issues             Json
  recommendations    Json
  confidenceScore    Decimal        @map("confidence_score") @db.Decimal(5, 2)
  modelAgreement     Decimal?       @map("model_agreement") @db.Decimal(5, 2)
  qualityScoreSpread Decimal?       @map("quality_score_spread") @db.Decimal(5, 2)
  createdAt          DateTime       @default(now()) @map("created_at")
  report             AnalysisReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("exam_quality_scores")
}

model AIExplanation {
  id                  Int            @id @default(autoincrement())
  reportId            Int            @unique @map("report_id")
  module              String         @db.VarChar(50)
  decision            String         @db.VarChar(191)
  reason              String         @db.Text
  confidence          Decimal        @db.Decimal(5, 2)
  evidenceSufficiency Decimal?       @map("evidence_sufficiency") @db.Decimal(5, 2)
  modelAgreement      Decimal?       @map("model_agreement") @db.Decimal(5, 2)
  createdAt           DateTime       @default(now()) @map("created_at")
  report              AnalysisReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("ai_explanations")
}

model QuestionHistory {
  id                 Int       @id @default(autoincrement())
  courseId           Int       @map("course_id")
  sourceQuestionId   Int?      @unique @map("source_question_id")
  questionText       String    @map("question_text") @db.Text
  semester           String    @db.VarChar(50)
  year               Int
  embeddingReference String?   @map("embedding_reference") @db.VarChar(500)
  similarityScore    Decimal?  @map("similarity_score") @db.Decimal(5, 2)
  createdAt          DateTime  @default(now()) @map("created_at")
  course             Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sourceQuestion     Question? @relation(fields: [sourceQuestionId], references: [id], onDelete: SetNull)

  @@index([courseId, year, semester])
  @@map("question_history")
}

/// Derived, regenerable data: one L2-normalised Float32LE vector per (owner, model).
model EmbeddingVector {
  id          Int      @id @default(autoincrement())
  ownerType   String   @map("owner_type") @db.VarChar(30) // QUESTION | QUESTION_HISTORY | SYLLABUS_CHUNK | COURSE_OUTCOME
  ownerId     Int      @map("owner_id")
  courseId    Int?     @map("course_id")
  model       String   @db.VarChar(80)
  dimension   Int
  vector      Bytes
  contentHash String   @map("content_hash") @db.Char(64)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([ownerType, ownerId, model])
  @@index([courseId, ownerType, model])
  @@map("embedding_vectors")
}

/// Faculty corrections on AI question labels. Every row is a human label; after a
/// semester of use this becomes the ground truth the project currently lacks.
model QuestionFeedback {
  id                  Int            @id @default(autoincrement())
  questionId          Int            @map("question_id")
  reportId            Int?           @map("report_id")
  facultyId           Int            @map("faculty_id")
  verdict             String         @db.VarChar(10) // UP | DOWN
  aiBloomLevel        String?        @map("ai_bloom_level") @db.VarChar(30)
  correctedBloomLevel String?        @map("corrected_bloom_level") @db.VarChar(30)
  aiTopic             String?        @map("ai_topic") @db.VarChar(191)
  correctedTopic      String?        @map("corrected_topic") @db.VarChar(191)
  note                String?        @db.Text
  createdAt           DateTime       @default(now()) @map("created_at")
  question            Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  report              AnalysisReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  faculty             User           @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([questionId, reportId, facultyId])
  @@index([facultyId, createdAt])
  @@index([reportId])
  @@map("question_feedback")
}

/// One LLM invocation (or sample set) behind a report. Written in the same transaction as the report;
/// runs that never produced a report are written fire-and-forget with reportId NULL.
model AnalysisRun {
  id               Int                 @id @default(autoincrement())
  reportId         Int?                @map("report_id")
  pipeline         String              @db.VarChar(60)
  promptId         String              @map("prompt_id") @db.VarChar(60)
  promptVersion    String              @map("prompt_version") @db.VarChar(40)
  promptHash       String              @map("prompt_hash") @db.Char(64)
  model            String              @db.VarChar(80)
  temperature      Decimal             @db.Decimal(3, 2)
  inputHash        String              @map("input_hash") @db.Char(64)
  sampleCount      Int                 @map("sample_count")
  cacheHit         Boolean             @default(false) @map("cache_hit")
  promptTokens     Int?                @map("prompt_tokens")
  completionTokens Int?                @map("completion_tokens")
  totalTokens      Int?                @map("total_tokens")
  latencyMs        Int                 @map("latency_ms")
  status           String              @db.VarChar(30) // OK | VALIDATION_FAILED | PROVIDER_ERROR
  agreementJson    Json?               @map("agreement_json")
  requestId        String?             @map("request_id") @db.VarChar(64)
  createdAt        DateTime            @default(now()) @map("created_at")
  report           AnalysisReport?     @relation(fields: [reportId], references: [id], onDelete: SetNull)
  samples          AnalysisRunSample[]

  @@index([reportId])
  @@index([inputHash, promptHash, model])
  @@index([createdAt])
  @@map("analysis_runs")
}

model AnalysisRunSample {
  id          Int         @id @default(autoincrement())
  runId       Int         @map("run_id")
  sampleIndex Int         @map("sample_index")
  rawResponse String      @map("raw_response") @db.LongText
  validated   Boolean
  createdAt   DateTime    @default(now()) @map("created_at")
  run         AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("analysis_run_samples")
}

/// Content-addressed cache of schema-valid LLM responses. Keyed per sampleIndex so a
/// replayed k=3 run reproduces its three distinct samples instead of one response thrice.
model LlmCacheEntry {
  id          Int      @id @default(autoincrement())
  cacheKey    String   @unique @map("cache_key") @db.Char(64) // sha256(promptHash|model|temperature|inputHash|sampleIndex)
  pipeline    String   @db.VarChar(60)
  rawResponse String   @map("raw_response") @db.LongText
  totalTokens Int      @default(0) @map("total_tokens")
  hitCount    Int      @default(0) @map("hit_count")
  tokensSaved Int      @default(0) @map("tokens_saved")
  createdAt   DateTime @default(now()) @map("created_at")
  lastUsedAt  DateTime @updatedAt @map("last_used_at")
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("llm_cache_entries")
}

model CourseOutcome {
  id          Int                 @id @default(autoincrement())
  courseId    Int                 @map("course_id")
  code        String              @db.VarChar(30)
  description String              @db.Text
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  mappings    QuestionCOMapping[]

  @@unique([courseId, code])
  @@index([courseId])
  @@map("course_outcomes")
}

model QuestionCOMapping {
  id              Int            @id @default(autoincrement())
  reportId        Int            @map("report_id")
  questionId      Int            @map("question_id")
  courseOutcomeId Int            @map("course_outcome_id")
  strength        String         @db.VarChar(30)
  decision        String         @db.VarChar(191)
  reason          String         @db.Text
  confidence      Decimal        @db.Decimal(5, 2)
  createdAt       DateTime       @default(now()) @map("created_at")
  report          AnalysisReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  question        Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  courseOutcome   CourseOutcome  @relation(fields: [courseOutcomeId], references: [id], onDelete: Cascade)

  @@unique([reportId, questionId, courseOutcomeId])
  @@index([questionId])
  @@index([courseOutcomeId])
  @@map("question_co_mappings")
}

model Rubric {
  id          Int             @id @default(autoincrement())
  courseId    Int             @map("course_id")
  createdById Int             @map("created_by_id")
  name        String          @db.VarChar(160)
  description String?         @db.Text
  criteria    Json
  maxScore    Decimal         @map("max_score") @db.Decimal(7, 2)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  answers     StudentAnswer[]

  @@index([courseId])
  @@index([createdById])
  @@map("rubrics")
}

model StudentAnswer {
  id                Int       @id @default(autoincrement())
  questionId        Int       @map("question_id")
  rubricId          Int?      @map("rubric_id")
  studentIdentifier String    @map("student_identifier") @db.VarChar(100)
  answerText        String    @map("answer_text") @db.LongText
  score             Decimal?  @db.Decimal(7, 2)
  feedback          Json?
  submittedAt       DateTime  @default(now()) @map("submitted_at")
  gradedAt          DateTime? @map("graded_at")
  question          Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  rubric            Rubric?   @relation(fields: [rubricId], references: [id], onDelete: SetNull)

  @@index([questionId])
  @@index([rubricId])
  @@map("student_answers")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(191)
  document  String?  @db.VarChar(255)
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@map("audit_logs")
}

model CopilotThread {
  id              Int              @id @default(autoincrement())
  facultyId       Int              @map("faculty_id")
  courseId        Int              @map("course_id")
  questionPaperId Int?             @map("question_paper_id")
  reportId        Int?             @map("report_id")
  title           String           @db.VarChar(200)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  faculty         User             @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  messages        CopilotMessage[]

  @@index([facultyId, courseId])
  @@map("copilot_threads")
}

model CopilotMessage {
  id        Int           @id @default(autoincrement())
  threadId  Int           @map("thread_id")
  role      String        @db.VarChar(20) // "user" | "assistant" | "system"
  content   String        @db.Text
  citations Json?
  createdAt DateTime      @default(now()) @map("created_at")
  thread    CopilotThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("copilot_messages")
}

model ChatSession {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  courseId  Int?             @map("course_id")
  examId    Int?             @map("exam_id")
  title     String           @db.VarChar(200)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  exam      QuestionPaper?   @relation(fields: [examId], references: [id], onDelete: SetNull)
  messages  ChatMessage[]
  contexts  CopilotContext[]

  @@index([userId, courseId])
  @@index([examId])
  @@map("chat_sessions")
}

model ChatMessage {
  id          Int         @id @default(autoincrement())
  sessionId   Int         @map("session_id")
  role        ChatRole
  content     String      @db.LongText
  aiReasoning String?     @map("ai_reasoning") @db.Text
  confidence  Decimal?    @db.Decimal(5, 2)
  createdAt   DateTime    @default(now()) @map("created_at")
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model CopilotContext {
  id         Int         @id @default(autoincrement())
  sessionId  Int         @map("session_id")
  sourceType String      @map("source_type") @db.VarChar(50)
  sourceId   Int?        @map("source_id")
  content    String      @db.LongText
  createdAt  DateTime    @default(now()) @map("created_at")
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, sourceType])
  @@map("copilot_contexts")
}

model Document {
  id            Int                 @id @default(autoincrement())
  userId        Int?                @map("user_id")
  title         String              @db.VarChar(255)
  originalName  String              @map("original_name") @db.VarChar(255)
  filePath      String              @map("file_path") @db.VarChar(500)
  mimeType      String              @map("mime_type") @db.VarChar(100)
  fileSize      Int                 @map("file_size")
  fileType      String              @default("PDF") @map("file_type") @db.VarChar(50) // PDF | COURSE_OUTLINE | IMAGE
  extractedText String?             @map("extracted_text") @db.LongText
  summary       String?             @db.LongText
  keyPoints     Json?               @map("key_points")
  status        String              @default("PROCESSED") @db.VarChar(50) // UPLOADED | PROCESSING | PROCESSED | ERROR
  metadata      Json?
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  chunks        DocumentChunk[]
  questions     GeneratedQuestion[]

  @@index([userId])
  @@index([createdAt])
  @@map("documents")
}

model DocumentChunk {
  id          Int      @id @default(autoincrement())
  documentId  Int      @map("document_id")
  chunkIndex  Int      @map("chunk_index")
  content     String   @db.LongText
  pageNumber  Int?     @map("page_number")
  section     String?  @db.VarChar(255)
  tokenCount  Int?     @map("token_count")
  embedding   Bytes?   @db.Blob
  createdAt   DateTime @default(now()) @map("created_at")
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("document_chunks")
}

model GeneratedQuestion {
  id            Int       @id @default(autoincrement())
  documentId    Int?      @map("document_id")
  userId        Int?      @map("user_id")
  topic         String?   @db.VarChar(255)
  difficulty    String    @db.VarChar(50)
  type          String    @db.VarChar(50) // MCQ | Short Answer | Descriptive | True/False | Viva | Conceptual | Application-based
  question      String    @db.Text
  options       Json?
  correctAnswer String?   @map("correct_answer") @db.Text
  explanation   String?   @db.Text
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  document      Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([userId])
  @@map("generated_questions")
}

