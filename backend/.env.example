PORT=5000
# MySQL from docker-compose is published on host port 3308 (3306 inside the container).
DATABASE_URL=mysql://acadiq_user:acadiq_pass@localhost:3308/acadiq
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional additional OpenAI-compatible chat providers, in fallback order.
# See ../docs/ai-providers.md. Each apiKeyEnv names a server environment variable.
AI_PROVIDERS_JSON=[]
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NARA_ROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_BACKUP_API_KEY=
# Second, different-vendor model used by the Dual Evaluator (default: qwen/qwen3.8-27b on Groq, gpt-4o on OpenAI).
DUAL_EVAL_SECONDARY_MODEL=
# Syllabus text is truncated to this many characters before any prompt. Groq's free tier allows ~8k tokens
# per request, so the default is 9000 there (30000 on OpenAI). A truncation note is appended when it cuts.
SYLLABUS_PROMPT_CHARS=9000

# Local question embeddings (Transformers.js + ONNX, no API key). Powers the shortlist->explain
# similarity/academic-memory path. Set EMBEDDING_ENABLED=false to force the legacy LLM-only path.
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_MODEL_DIR=models
# Dev downloads the model on first use; production images bake it and set this to false.
EMBEDDING_ALLOW_REMOTE=true
# Cosine floor for "worth an LLM call"; the effective floor is max(this, p95 of the previous paper's own pairs).
# Run `npm run embeddings:calibrate` to see your data's distribution before changing it.
EMBEDDING_SIMILARITY_FLOOR=0.55
EMBEDDING_NEAR_DUPLICATE=0.9
EMBEDDING_TOP_K=5
EMBEDDING_MAX_CANDIDATE_PAIRS=40

# Reliability layer. `reliability: "verified"` on an analysis request runs RELIABILITY_SAMPLE_COUNT
# sequential samples at RELIABILITY_SAMPLE_TEMPERATURE and reports model agreement (answer stability).
# Full audits are always single-run. LLM_MAX_CONCURRENT is a process-wide cap shared by all callers.
RELIABILITY_SAMPLE_COUNT=3
RELIABILITY_SAMPLE_TEMPERATURE=0.6
LLM_MAX_CONCURRENT=2
# Content-hash cache of schema-valid LLM responses (keyed by promptHash|model|temperature|inputHash|sampleIndex).
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_DAYS=30
# Raw provenance samples older than this are pruned by `npm run traces:prune`; run metadata is kept.
TRACE_RETENTION_DAYS=90

# Optional SMTP for password-reset emails. Leave empty in development: the reset link is shown in the UI instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=AcadIQ Support
SMTP_FROM_EMAIL=
